// GEET database schema
// SQLite for local development; identical schema targets PostgreSQL via DATABASE_URL.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------ AUTH (Auth.js v5)

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // "user" | "admin"
  bannedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  playlists        Playlist[]
  likedTracks      LikedTrack[]
  likedAlbums      LikedAlbum[]
  likedPlaylists   LikedPlaylist[]
  followedArtists  FollowedArtist[]
  listeningHistory ListeningHistory[]
  recentlyPlayed   RecentlyPlayed[]
  searchHistory    SearchHistory[]
  preferences      UserPreference?
  notifications    Notification[]
  devices          Device[]
  queue            Queue?
  reportsMade      Report[]          @relation("reportsMade")

  @@index([email])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  displayName     String?
  bio             String?
  favoriteArtists String? // JSON array of artist names
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ------------------------------------------------------------------ MUSIC CATALOG

model Genre {
  id              String  @id @default(cuid())
  name            String  @unique
  slug            String  @unique
  description     String?
  imageUrl        String?
  thumbnailColor  String?
  createdAt       DateTime @default(now())
  tracks          Track[]
}

model Artist {
  id               String   @id @default(cuid())
  name             String   @unique
  normalizedName   String   @unique
  imageUrl         String?
  thumbnailColor   String?
  verified         Boolean  @default(false)
  bio              String?
  followers        Int      @default(0)
  monthlyListeners Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tracks    Track[]
  albums    Album[]
  followedBy FollowedArtist[]
  featuredIn FeaturedContent[]

  @@index([name])
}

model Track {
  id             String   @id @default(cuid())
  title          String
  artistName     String
  artistId       String?
  albumId        String?
  durationSec    Int?
  thumbnailUrl   String?
  thumbnailColor String?
  popularity     Int      @default(50)
  genreId        String?
  createdAt      DateTime @default(now())

  artist    Artist?        @relation(fields: [artistId], references: [id])
  genre     Genre?         @relation(fields: [genreId], references: [id])
  sources   TrackSource[]
  albumTracks AlbumTrack[]
  playlistTracks PlaylistTrack[]
  likedBy   LikedTrack[]
  listened  ListeningHistory[]
  recentlyPlayed RecentlyPlayed[]
  featuredIn FeaturedContent[]

  @@index([title])
  @@index([artistName])
  @@index([popularity])
}

model TrackSource {
  id              String   @id @default(cuid())
  trackId         String
  provider        String // "youtube"
  providerVideoId String
  title           String?
  artistName      String?
  thumbnailUrl    String?
  metadata        String? // JSON snapshot (channel, publishedAt, etc.)
  lastVerifiedAt  DateTime?
  createdAt       DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([provider, providerVideoId])
  @@index([trackId])
}

model Album {
  id             String   @id @default(cuid())
  title          String
  artistId       String
  artistName     String // denormalized
  coverUrl       String?
  thumbnailColor String?
  year           Int
  type           String // "album" | "single" | "ep" | "compilation"
  createdAt      DateTime @default(now())

  artist Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks AlbumTrack[]
  likedBy LikedAlbum[]
  featuredIn FeaturedContent[]

  @@index([artistId])
  @@index([title])
}

model AlbumTrack {
  id        String @id @default(cuid())
  albumId   String
  trackId   String
  position  Int

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([albumId, trackId])
  @@index([albumId, position])
}

// ------------------------------------------------------------------ USER LIBRARY

model Playlist {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  isPublic       Boolean  @default(true)
  coverUrl       String?
  thumbnailColor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]
  likedBy LikedPlaylist[]
  featuredIn FeaturedContent[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model LikedTrack {
  userId  String
  trackId String
  likedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([trackId])
}

model LikedAlbum {
  userId  String
  albumId String
  likedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
}

model LikedPlaylist {
  userId     String
  playlistId String
  likedAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@id([userId, playlistId])
}

model FollowedArtist {
  userId   String
  artistId String
  followedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
}

// ------------------------------------------------------------------ ACTIVITY

model ListeningHistory {
  id          String   @id @default(cuid())
  userId      String
  trackId     String
  source      String? // "queue" | "search" | "playlist" | ...
  playedAt    DateTime @default(now())
  durationSec Int?
  progressSec Int?
  completion  Int? // 0-100

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([trackId])
}

model RecentlyPlayed {
  id       String   @id @default(cuid())
  userId   String
  trackId  String
  playedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ------------------------------------------------------------------ PREFERENCES & STATE

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("dark")
  volume             Int      @default(80)
  muted              Boolean  @default(false)
  repeatMode         String   @default("off")
  shuffle            Boolean  @default(false)
  lastPlayedTrackId  String?
  lastQueue          String? // JSON array of track DTOs
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Queue {
  id           String   @id @default(cuid())
  userId       String   @unique
  trackIds     String // JSON array
  currentIndex Int      @default(0)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------ SUPPORT

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "like" | "playlist" | "system" | ...
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  name       String
  platform   String?
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String // "track" | "playlist" | "user"
  targetId   String
  reason     String
  status     String   @default("open")
  createdAt  DateTime @default(now())

  reporter User @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model FeaturedContent {
  id          String   @id @default(cuid())
  section     String // "hero" | "trending" | ...
  title       String
  subtitle    String?
  artworkUrl  String?
  trackId     String?
  artistId    String?
  albumId     String?
  playlistId  String?
  externalUrl String?
  position    Int      @default(0)
  active      Boolean  @default(true)

  track  Track?  @relation(fields: [trackId], references: [id])
  artist Artist? @relation(fields: [artistId], references: [id])
  album  Album?  @relation(fields: [albumId], references: [id])
  playlist Playlist? @relation(fields: [playlistId], references: [id])

  @@index([section, active, position])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  properties String // JSON
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}